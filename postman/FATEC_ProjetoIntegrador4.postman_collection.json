  "item": [
    {
      "name": "Cadastro de animais",
      "item": [
        {
          "name": "Listar animais",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{animal_base_url}}/api/animals-registration"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna 200 e uma lista', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar registro de animal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": \"2026-01-15\",\n  \"tipoAnimal\": \"Cao\",\n  \"quantidade\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{animal_base_url}}/api/animals-registration"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cria registro e guarda o ID', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.exist;",
                  "  pm.environment.set('animal_id', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar registro criado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{animal_base_url}}/api/animals-registration/{{animal_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Encontra o registro', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get('animal_id')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar registro criado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": \"2026-01-16\",\n  \"tipoAnimal\": \"Gato\",\n  \"quantidade\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{animal_base_url}}/api/animals-registration/{{animal_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Atualiza registro', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().tipoAnimal).to.eql('Gato');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Excluir registro criado",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{animal_base_url}}/api/animals-registration/{{animal_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Exclui registro', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticacao e administradores",
      "item": [
        {
          "name": "Health da API de autenticacao",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{auth_base_url}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API de autenticacao disponivel', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login de administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"senha\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{auth_base_url}}/api/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login retorna JWT', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a('string');",
                  "  pm.environment.set('admin_token', body.token);",
                  "  pm.environment.set('admin_id', body.admin.idAdmin);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar administrador autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{auth_base_url}}/api/admin/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JWT autorizado', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().admin).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar administradores",
          "request": {
            "method": "GET",
            "header": [
              {
